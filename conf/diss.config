process {

    withName: DISS_FINAL_EXPORT {

        publishDir = [
            path: params.diss_outdir,
            mode: 'copy',
            pattern: 'final_exports/*',
            saveAs: { filename -> filename.replaceFirst(/^final_exports\//, '') }
        ]

        cpus = 2
        memory = '8 GB'
        time = '2h'
    }
    withName: DISS_GUIDE_FAMILY_CLASSIFICATION {
        cpus = 2
        memory = '8 GB'
        time = '1h'
    }
}
