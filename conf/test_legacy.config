/*
========================================================================================
    Nextflow test profile — LEGACY (pre-2.4.0) param names
========================================================================================
    Identical to `conf/test.config` but expresses the inputs using the deprecated
    unprefixed param names, so it exercises the backwards-compatibility alias in
    nextflow.config. Running `-profile test_legacy` must resolve to the same effective
    b2f_* params as `-profile test`.

        nextflow run Elembio/bases2fastq-nf -profile test_legacy,docker

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Test profile (legacy param names)'
    config_profile_description = 'Same as test, but supplies deprecated pre-2.4.0 param names via the backwards-compat alias'

    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '6.h'

    run_dir = "s3://element-public-data/bases2fastq-share/bases2fastq-v2/20230404-bases2fastq-sim-151-151-9-9/"

    // legacy names — remapped to b2f_run_manifest / b2f_settings by the alias
    run_manifest = "s3://element-public-data/bases2fastq-share/bases2fastq-v2/20230404-bases2fastq-sim-151-151-9-9/RunManifest.csv"
    settings     = ["R1AdapterTrim,true", "R2AdapterTrim,true"]
}

process {
    withName: BASES2FASTQ {
        cpus = 2
        memory = 6.GB
        time = 2.h
    }
}

cleanup = false

aws {
   batch {
      cliPath = '/home/ec2-user/miniconda/bin/aws'
      maxParallelTransfers = 10
      maxTransferAttempts = 3
   }
   client {
      maxConnections = 10
      uploadMaxThreads = 10
      maxErrorRetry = 3

      uploadRetrySleep = 1000
      uploadChunkSize = 32.MB
   }
}
